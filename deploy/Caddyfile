{$API_DOMAIN} {
    encode zstd gzip
    reverse_proxy backend:8000
    request_body {
        max_size 6MB
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
